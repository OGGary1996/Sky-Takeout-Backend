<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.sky.mapper.ReportMapper">
    <!--  根据日期统计单日营业额  -->
    <select id="getTurnoverByDate" resultType="Double">
        SELECT SUM(amount) FROM orders
        <where>
            <if test="begin != null ">
                AND order_time &gt; #{begin}
            </if>
            <if test="end != null ">
                AND order_time &lt; #{end}
            </if>
            <if test="status != null ">
                AND status = #{status}
            </if>
        </where>
    </select>

    <!-- 根据日期统计当前新增的用户与当前日期之前总的用户  -->
    <select id="getUserByDate" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM user
        <where>
            <if test="begin != null">
                AND create_time &gt; #{begin}
            </if>
            <if test="end != null">
                AND create_time &lt; #{end}
            </if>
        </where>
    </select>

    <!-- 根据日期统计当日的订单总数/有效订单数与一段时间的总的订单  -->
    <select id="getOrderCountByDate" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM orders
        <where>
            <if test="begin != null">
                AND order_time &gt; #{begin}
            </if>
            <if test="end != null">
                AND order_time &lt; #{end}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
    </select>

    <!--  获取销售前10的商品  -->
    <select id="getSalesTop10ByDateRange" resultType="com.sky.dto.GoodsSalesDTO">
        SELECT
            od.name AS salesName,
            SUM(od.number) AS salesNumber
        FROM order_detail od
        LEFT JOIN orders o ON od.order_id = o.id
        <where>
            <if test="begin != null">
                AND o.order_time &gt; #{begin}
            </if>
            <if test="end != null">
                AND o.order_time &lt; #{end}
            </if>
        </where>
        AND o.status = 5
        GROUP BY salesName
        ORDER BY salesNumber DESC
        LIMIT 10
    </select>
</mapper>
